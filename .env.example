NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Public base URL (used to build local upload URLs)
APP_URL=http://localhost:3000
# Comma separated origins, or * (Android apps do not send Origin; restrict for web clients)
CORS_ORIGINS=*

# MySQL / MariaDB (XAMPP: mysql://root:@localhost:3306/cricket)
DATABASE_URL="mysql://root:@localhost:3306/cricket"

# JWT - use a long random secret (>= 32 chars) in production
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Google OAuth: comma separated client IDs accepted as ID-token audience (Web client ID used by Android Credential Manager)
GOOGLE_CLIENT_IDS=xxxxxxxx.apps.googleusercontent.com
# Development-only login without Google (forced off in production)
AUTH_DEV_LOGIN=false

# Redis: required for multi-instance deployments (locks, cache, BullMQ, Socket.IO adapter)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Storage: local | s3 (any S3-compatible: AWS, MinIO, Cloudflare R2, DigitalOcean Spaces...)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for objects (CDN / bucket URL)
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# Firebase Cloud Messaging service account JSON path (empty = push disabled, notifications still stored)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Rate limiting (per IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300

# Emails automatically granted SUPER_ADMIN on login
SUPER_ADMIN_EMAILS=

# JSON structured logs (recommended in production)
LOG_JSON=false
